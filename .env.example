# Google Sheet ID (de la URL: docs.google.com/spreadsheets/d/<ID>/edit)
SHEET_ID=tu-sheet-id-aqui

# Service Account JSON — pegar TODO el contenido del archivo JSON en una sola línea
# (alternativa: SA_JSON_PATH apuntando a un archivo local)
SA_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# IA — cadena de fallback (mínimo OpenRouter o Gemini)
OPENROUTER_API_KEY=sk-or-v1-xxx
GEMINI_API_KEY=AIzaSy-xxx
GROQ_API_KEY=gsk_xxx

# Background Check API (red interna Docker)
BG_API_URL=http://dentaklin_bg-api:8000
BG_API_KEY=tu-bg-api-key-aqui
BG_API_TIMEOUT=60

# Telegram (opcional — alertas de candidatos con delitos graves)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
